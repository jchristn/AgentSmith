      "type": "table",
      "title": "Failed and rejected spans",
      "description": "Traces with a span in error or a request answered 4xx or 5xx.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error || span.http.response.status_code >= 400 }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
