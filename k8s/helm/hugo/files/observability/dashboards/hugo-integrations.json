        "w": 4,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Error ratio",
      "description": "Share of outbound calls that did not succeed over the averaging window.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hugo_outbound_requests_total{job=~\"$job\", service=~\"$service\", result!~\"(?i)(ok|success|2xx|3xx)\"}[$window])) / clamp_min(sum(rate(hugo_outbound_requests_total{job=~\"$job\", service=~\"$service\"}[$window])), 1e-9) or on() vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": [],
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
