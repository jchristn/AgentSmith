  "description": "One-glance health for Hugo: server up, traffic and error ratio, agent turns, tool calls, approvals, model usage, background jobs, and recent logs. Start here.",
  "tags": [
    "hugo"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
