@echo off
rem Internal helper for deploy.bat, update.bat, and factory-reset.bat: writes k8s\.work\deploy\kustomization.yaml
rem (the target overlay plus components, image tag HUGO_TAG) and applies it, then records the shape on the namespace.
rem Usage: render.bat TARGET "COMPONENTS"   (TARGET k3s, production, or minikube; COMPONENTS comma-separated or empty)
setlocal enabledelayedexpansion
set KCTX=
if not "%HUGO_KUBE_CONTEXT%"=="" set KCTX=--context %HUGO_KUBE_CONTEXT%
if "%HUGO_TAG%"=="" set HUGO_TAG=v0.1.0
set TARGET=%~1
set COMPONENTS=%~2
if "%TARGET%"=="k3s" set TDIR=k8s/overlays/k3s
if "%TARGET%"=="production" set TDIR=k8s/overlays/production
if "%TARGET%"=="minikube" set TDIR=minikube/overlay
if "%TDIR%"=="" (
  echo [hugo] error: unknown target %TARGET% ^(use k3s, production, or minikube^)
  exit /b 1
)
set DIR=%~dp0..\.work\deploy
if not exist "%DIR%" mkdir "%DIR%"
set FILE=%DIR%\kustomization.yaml
> "%FILE%" echo # Generated by k8s\scripts; do not edit.
>> "%FILE%" echo apiVersion: kustomize.config.k8s.io/v1beta1
>> "%FILE%" echo kind: Kustomization
>> "%FILE%" echo namespace: hugo
>> "%FILE%" echo resources:
>> "%FILE%" echo   - ../../../%TDIR%
if not "%COMPONENTS%"=="" (
  >> "%FILE%" echo components:
  for %%c in (%COMPONENTS:,= %) do (
    if not exist "%~dp0..\components\%%c" (
      echo [hugo] error: unknown component %%c ^(use postgres and/or observability^)
      exit /b 1
    )
    >> "%FILE%" echo   - ../../components/%%c
  )
)
>> "%FILE%" echo images:
>> "%FILE%" echo   - name: jchristn77/hugo-server
>> "%FILE%" echo     newTag: %HUGO_TAG%
>> "%FILE%" echo   - name: jchristn77/hugo-dashboard
>> "%FILE%" echo     newTag: %HUGO_TAG%
echo [hugo] applying %TDIR% with "%COMPONENTS%" ^(tag %HUGO_TAG%^)
kubectl %KCTX% apply -k "%DIR%" || exit /b 1
kubectl %KCTX% annotate namespace hugo --overwrite hugo-deploy-target=%TARGET% hugo-deploy-components=%COMPONENTS% >nul
endlocal
