{
  "name": "hugo-dashboard",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Operator console for Hugo, the multi-tenant super agent server (Agent Smith).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.js",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:export": "node scripts/i18n-check.mjs --missing"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "marked": "^18.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
