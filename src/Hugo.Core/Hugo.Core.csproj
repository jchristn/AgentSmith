<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hugo.Core</RootNamespace>
    <AssemblyName>Hugo.Core</AssemblyName>
    <Description>Hugo core: models, data layer, security, secret cipher, template rendering, and instruction compilation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PolyPrompt" Version="3.2.0" />
    <PackageReference Include="PrettyId" Version="2.0.2" />
    <PackageReference Include="Radiant" Version="0.1.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hugo.Connectors.Abstractions\Hugo.Connectors.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Seed\Prompts\*.md" LogicalName="Hugo.Core.Seed.Prompts.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

</Project>
