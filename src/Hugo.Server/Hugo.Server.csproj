<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hugo.Server</RootNamespace>
    <AssemblyName>Hugo.Server</AssemblyName>
    <StartupObject>Hugo.Server.Program</StartupObject>
    <Description>Hugo server: REST, MCP, A2A, and OpenAI-compatible surfaces over the agent runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SyslogLogging" Version="2.4.1" />
    <PackageReference Include="Voltaic" Version="2.3.0" />
    <PackageReference Include="Watson" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hugo.Core\Hugo.Core.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Abstractions\Hugo.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Ssh\Hugo.Connectors.Ssh.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Storage\Hugo.Connectors.Storage.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Sql\Hugo.Connectors.Sql.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Logging\Hugo.Connectors.Logging.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Redis\Hugo.Connectors.Redis.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Http\Hugo.Connectors.Http.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Observability\Hugo.Connectors.Observability.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Aws\Hugo.Connectors.Aws.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Kubernetes\Hugo.Connectors.Kubernetes.csproj" />
    <ProjectReference Include="..\Hugo.Connectors.Docker\Hugo.Connectors.Docker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="hugo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

</Project>
