  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "description": "Prometheus scrape job of the Hugo server (hugo-server in Docker Compose).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"hugo.*\"}, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(up{job=~\"hugo.*\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "hide": 0
      },
