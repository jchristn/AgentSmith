        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(hugo_agent_turns_total{job=~\"$job\", surface=~\"$surface\", outcome=\"error\"}[$__range]))) or on() vector(0)",
          "legendFormat": "__auto",
