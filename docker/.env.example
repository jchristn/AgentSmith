# Copy to docker/.env (git ignores it). ./start.sh generates the two keys when they are missing.

# Encrypts every secret Hugo stores (base64, 32 bytes or more). Losing it makes stored secrets unreadable.
HUGO_MASTER_KEY=
# Signs session tokens.
HUGO_AUTH_SIGNING_KEY=

# Database: Sqlite (default) or Postgresql. Postgresql also needs: docker compose --profile postgres up -d
HUGO_DB_TYPE=Sqlite
HUGO_DB_PASSWORD=hugo

# Host ports (bound to 127.0.0.1).
HUGO_REST_PORT=8800
HUGO_DASHBOARD_PORT=8801
HUGO_GRAFANA_PORT=3000
HUGO_PROMETHEUS_PORT=9090
HUGO_TEMPO_PORT=3200
HUGO_LOKI_PORT=3100

# Grafana login. Change these anywhere other than your own machine.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
