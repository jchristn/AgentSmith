    {
      "type": "timeseries",
      "title": "Iterations by service and result",
      "description": "Background service iterations per interval by service and result (ok, idle, error).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, result) (increase(hugo_background_iterations_total{job=~\"$job\", service=~\"$service\"}[$__rate_interval])) or on() label_replace(vector(0), \"result\", \"none\", \"\", \"\")",
          "legendFormat": "{{service}} {{result}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
