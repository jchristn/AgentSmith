  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "description": "Prometheus scrape job of the Hugo server (hugo-server in Docker Compose).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"hugo.*\"}, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(up{job=~\"hugo.*\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Background service",
        "description": "Background service.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hugo_background_iterations_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(hugo_background_iterations_total, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "hide": 0
      },
      {
        "name": "window",
        "label": "Average over",
        "type": "custom",
        "query": "5m,15m,1h,6h",
        "description": "Window for rates, averages, and percentiles. Agent and tool traffic is bursty, so short windows leave gaps.",
        "current": {
          "selected": true,
          "text": "15m",
          "value": "15m"
        },
        "options": [
          {
            "selected": false,
            "text": "5m",
            "value": "5m"
          },
          {
