    {
      "type": "stat",
      "title": "MCP requests",
      "description": "MCP JSON-RPC requests in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(hugo_mcp_requests_total{job=~\"$job\"}[$__range]))) or on() vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
