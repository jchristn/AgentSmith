            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(hugo_mcp_requests_total{job=~\"$job\", outcome!~\"(?i)(ok|success|succeeded|completed)\"}[$__range]))) or on() vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
