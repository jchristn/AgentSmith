        "hide": 0
      },
      {
        "name": "kind",
        "label": "Kind",
        "description": "Request kind (chat, embeddings).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hugo_model_requests_total, kind)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(hugo_model_requests_total, kind)",
        "refresh": 2,
        "sort": 1,
